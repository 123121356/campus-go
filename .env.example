# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 절대 GitHub에 올리지 마세요)

# 공공데이터포털 '일반 인증키(Decoding)' — TAGO 버스정류소정보 + 버스도착정보 활용신청 필요
DATA_GO_KR_KEY=

# 삼척시 TAGO 도시코드 (기본 32070). /api/stops?cities=1 로 확인 가능
TAGO_CITY_CODE=32070

# LLM: 둘 중 하나만 있어도 됩니다 (Gemini 우선)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 커뮤니티·제보 공유 저장소 (Upstash Redis, 무료)
# Vercel › 프로젝트 › Storage › Upstash(Redis) 생성 후 프로젝트에 연결하면 Vercel에는 자동으로 들어갑니다.
# 내 PC(start.bat)에서도 공유하려면 Upstash 콘솔의 REST URL·TOKEN 을 아래에 붙여 넣으세요.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 메신저 알림 (3D AI 요정에게 "텔레그램/디스코드로 보내줘") — 위의 Upstash Redis 가 꼭 있어야 합니다.
# 텔레그램: 텔레그램에서 @BotFather → /newbot → 받은 토큰과 봇 아이디(…_bot)를 넣으세요. (디스코드는 키가 필요 없어요)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=
# 주기 알림 실행용 비밀값 (아무 긴 문자열). GitHub Actions secret NOTIFY_SECRET 에도 같은 값을 넣으세요.
NOTIFY_SECRET=
# 1 이면 내 PC(start.bat)에서도 1분마다 주기 알림을 보냅니다 (배포 없이 시연할 때만. 배포본과 같이 켜 두지 마세요)
NOTIFY_LOCAL_RUN=

# 요즘 화제 학습 (learn-trends.bat / GitHub Actions 6시간마다) — 3D NPC가 커뮤니티·검색 트렌드를 말하게 함
# 구글 트렌드·디시인사이드는 키가 필요 없습니다. 아래는 있으면 더 풍부해집니다.
# 유튜브: console.cloud.google.com → YouTube Data API v3 사용 설정 → 사용자 인증 정보 → API 키
YOUTUBE_API_KEY=
# 네이버 데이터랩: developers.naver.com → 애플리케이션 등록 → 사용 API '데이터랩(검색어트렌드)'
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
