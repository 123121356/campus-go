# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 절대 GitHub에 올리지 마세요)

# 공공데이터포털 '일반 인증키(Decoding)' — TAGO 버스정류소정보 + 버스도착정보 활용신청 필요
DATA_GO_KR_KEY=

# 삼척시 TAGO 도시코드 (기본 32070). /api/stops?cities=1 로 확인 가능
TAGO_CITY_CODE=32070

# LLM: 둘 중 하나만 있어도 됩니다 (Gemini 우선)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 커뮤니티·제보 공유 저장소 (Upstash Redis, 무료)
# Vercel › 프로젝트 › Storage › Upstash(Redis) 생성 후 프로젝트에 연결하면 Vercel에는 자동으로 들어갑니다.
# 내 PC(start.bat)에서도 공유하려면 Upstash 콘솔의 REST URL·TOKEN 을 아래에 붙여 넣으세요.
KV_REST_API_URL=
KV_REST_API_TOKEN=
